index 0000000..84c1d9e
--- /dev/null
+++ b/tests/test_training_api_status.py
@@ -0,0 +1,87 @@
+import json
+import subprocess
+
+from scripts import training_api
+
+
+def test_status_payload_includes_structured_status_and_legacy_fields(monkeypatch, tmp_path):
+    run_dir = tmp_path / "run"
+    run_dir.mkdir()
+    (run_dir / "history.jsonl").write_text('{"step": 5}\n', encoding="utf-8")
+
+    def fake_runner(args, timeout=120):
+        if args[:2] == ["docker", "inspect"]:
+            return subprocess.CompletedProcess(args, 0, json.dumps([{"State": {"Running": True, "Status": "running", "ExitCode": 0, "Health": {"Status": "healthy", "FailingStreak": 0}}}]), "")
+        if args[:2] == ["docker", "logs"]:
+            return subprocess.CompletedProcess(args, 0, "step 5", "")
+        raise AssertionError(args)
+
+    monkeypatch.setattr(training_api, "RUN_DIR", run_dir)
+    status = training_api.status_payload(runner=fake_runner)
+
+    assert status["running"] is True
+    assert status["state"] == "running"
+    assert status["schema_version"] == "2026-06-training-control-v1"
+    assert status["container"]["health"] == "healthy"
+    assert "reason" in status
+    assert "detail" in status
+    assert "trainer" in status
+    assert "gpu" in status
+    assert "logs" in status
+    assert "actions" in status
+
+
+def test_status_payload_reports_trainer_process_dead(monkeypatch, tmp_path):
+    def fake_runner(args, timeout=120):
+        if args[:2] == ["docker", "inspect"]:
+            return subprocess.CompletedProcess(args, 1, "", "No such container")
+        if args[:2] == ["docker", "logs"]:
+            return subprocess.CompletedProcess(args, 1, "", "No such container")
+        raise AssertionError(args)
+
+    monkeypatch.setattr(training_api, "RUN_DIR", tmp_path)
+    status = training_api.status_payload(runner=fake_runner)
+
+    assert status["running"] is False
+    assert status["state"] == "not-found"
+    assert status["reason"] == "trainer_process_dead"
+    assert status["actions"]["can_start"] is True
+
+
+def test_action_response_truncates_output_and_includes_plain_message(monkeypatch, tmp_path):
+    def fake_runner(args, timeout=120):
+        if args[:2] == ["docker", "inspect"]:
+            return subprocess.CompletedProcess(args, 1, "", "No such container")
+        if args[:2] == ["docker", "logs"]:
+            return subprocess.CompletedProcess(args, 1, "", "No such container")
+        raise AssertionError(args)
+
+    result = subprocess.CompletedProcess(["docker", "compose"], 1, "x" * 2000, "bad" * 1000)
+    response = training_api.action_response("start", result, runner=fake_runner)
+
+    assert response["action"] == "start"
+    assert response["result"] == "failed"
+    assert response["message"] == "Start command failed."
+    assert len(response["stdout"]) <= 800
+    assert len(response["stderr"]) <= 800
+    assert "status" in response
+
+
+def test_action_lock_returns_busy_without_running_command(monkeypatch):
+    training_api.ACTION_IN_PROGRESS = True
+    try:
+        response = training_api.busy_action_response("restart")
+    finally:
+        training_api.ACTION_IN_PROGRESS = False
+
+    assert response["result"] == "busy"
+    assert response["message"] == "Another trainer control action is already running."
+
+
+def test_timeout_action_response_is_structured():
+    response = training_api.timeout_action_response("restart", "docker compose restart timed out")
+
+    assert response["result"] == "failed"
+    assert response["returncode"] == 124
+    assert response["message"] == "Restart command failed."
+    assert "timed out" in response["stderr"]
