+#!/usr/bin/env python3
+"""Structured trainer status helpers for OSS training controls.
+
+This module is intentionally stdlib-only and side-effect-light so the tailnet
+control API can report operator-grade state without coupling tests to Docker.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Callable
+
+SCHEMA_VERSION = "2026-06-training-control-v1"
+
+REASON_TRAINER_OK = "trainer_ok"
+REASON_TRAINER_PROCESS_DEAD = "trainer_process_dead"
+REASON_GPU_TELEMETRY_OK = "gpu_telemetry_ok"
+REASON_GPU_TELEMETRY_MISSING = "gpu_telemetry_missing"
+REASON_TRAINER_STALE_STEP = "trainer_stale_step"
+REASON_INFRA_OK_BUT_TRAINER_STALE = "infra_ok_but_trainer_stale"
+
+Runner = Callable[[list[str], int], subprocess.CompletedProcess[str]]
+
+
+def utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def isoformat_z(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _age_seconds(path: Path, now: datetime) -> float | None:
+    try:
+        return max(0.0, now.timestamp() - path.stat().st_mtime)
+    except OSError:
+        return None
+
+
+def parse_docker_inspect(stdout: str) -> dict[str, Any]:
+    try:
+        data = json.loads(stdout)
+        info = data[0]
+        state = info.get("State", {})
+    except (json.JSONDecodeError, IndexError, TypeError, AttributeError):
+        return {
+            "running": False,
+            "state": "unknown",
+            "reason": "docker_inspect_parse_failed",
+            "error": "Could not parse docker inspect output.",
+        }
+
+    health = state.get("Health") or {}
+    health_log = health.get("Log") or []
+    health_tail = []
+    for entry in health_log[-3:]:
+        if isinstance(entry, dict):
+            health_tail.append(str(entry.get("Output", "")).strip())
+
+    return {
+        "running": bool(state.get("Running", False)),
+        "state": state.get("Status", "exited"),
+        "exit_code": state.get("ExitCode"),
+        "started_at": state.get("StartedAt", ""),
+        "finished_at": state.get("FinishedAt", ""),
+        "health": health.get("Status"),
+        "health_failing_streak": health.get("FailingStreak"),
+        "health_log_tail": health_tail,
+        "oom_killed": bool(state.get("OOMKilled", False)),
+        "dead": bool(state.get("Dead", False)),
+        "restarting": bool(state.get("Restarting", False)),
+        "error": state.get("Error", ""),
+    }
+
+
+def docker_container_probe(
+    *,
+    container_name: str,
+    runner: Runner,
+    timeout: int = 120,
+) -> dict[str, Any]:
+    try:
+        result = runner(["docker", "inspect", container_name], timeout)
+    except subprocess.TimeoutExpired:
+        return {
+            "running": False,
+            "state": "unknown",
+            "reason": REASON_TRAINER_PROCESS_DEAD,
+            "error": "docker inspect timed out",
+            "returncode": 124,
+        }
+    except OSError as exc:
+        return {
+            "running": False,
+            "state": "unknown",
+            "reason": REASON_TRAINER_PROCESS_DEAD,
+            "error": str(exc),
+            "returncode": 127,
+        }
+    if result.returncode != 0:
+        return {
+            "running": False,
+            "state": "not-found",
+            "reason": REASON_TRAINER_PROCESS_DEAD,
+            "error": (result.stderr or result.stdout or "docker inspect failed").strip(),
+            "returncode": result.returncode,
+        }
+    parsed = parse_docker_inspect(result.stdout)
+    parsed["returncode"] = result.returncode
+    return parsed
+
+
+def recent_logs_probe(
+    *,
+    container_name: str,
+    runner: Runner,
+    lines: int = 20,
+    timeout: int = 120,
+) -> dict[str, Any]:
+    try:
+        result = runner(["docker", "logs", "--tail", str(lines), container_name], timeout)
+    except subprocess.TimeoutExpired:
+        return {"stdout": "", "stderr": "docker logs timed out", "returncode": 124}
+    except OSError as exc:
+        return {"stdout": "", "stderr": str(exc), "returncode": 127}
+    stdout = result.stdout or ""
+    stderr = result.stderr or ""
+    return {
+        "stdout": stdout[-4000:],
+        "stderr": stderr[-2000:],
+        "returncode": result.returncode,
+    }
+
+
+def _parse_json_line(line: str) -> dict[str, Any] | None:
+    try:
+        value = json.loads(line)
+    except json.JSONDecodeError:
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def latest_training_step_from_run_dir(run_dir: Path, now: datetime | None = None) -> dict[str, Any]:
+    now = now or utcnow()
+    history = run_dir / "history.jsonl"
+    metrics = run_dir / "metrics.json"
+
+    if history.exists():
+        latest: dict[str, Any] | None = None
+        try:
+            for line in history.read_text(encoding="utf-8", errors="replace").splitlines():
+                item = _parse_json_line(line)
+                if item is not None and "step" in item:
+                    latest = item
+        except OSError as exc:
+            return {"status": "unknown", "latest_step": None, "reason": "history_read_failed", "detail": str(exc)}
+        step = latest.get("step") if latest else None
+        return {
+            "status": "healthy" if step is not None else "unknown",
+            "reason": "history_step_found" if step is not None else "history_missing_step",
+            "latest_step": int(step) if isinstance(step, int | float) else None,
+            "loss": latest.get("loss") if latest else None,
+            "source": "history.jsonl",
+            "source_mtime_age_seconds": _age_seconds(history, now),
+        }
+
+    if metrics.exists():
+        try:
+            data = json.loads(metrics.read_text(encoding="utf-8", errors="replace"))
+        except (OSError, json.JSONDecodeError) as exc:
+            return {"status": "unknown", "latest_step": None, "reason": "metrics_read_failed", "detail": str(exc)}
+        step = data.get("step") or data.get("latest_step")
+        return {
+            "status": "healthy" if step is not None else "unknown",
+            "reason": "metrics_step_found" if step is not None else "metrics_missing_step",
+            "latest_step": int(step) if isinstance(step, int | float) else None,
+            "loss": data.get("loss"),
+            "source": "metrics.json",
+            "source_mtime_age_seconds": _age_seconds(metrics, now),
+        }
+
+    return {
+        "status": "unknown",
+        "reason": "training_progress_missing",
+        "latest_step": None,
+        "source": None,
+        "source_mtime_age_seconds": None,
+    }
+
+
+def gpu_status_probe(run_dir: Path, now: datetime | None = None, max_age_seconds: int = 600) -> dict[str, Any]:
+    now = now or utcnow()
+    path = run_dir / "gpu_status.json"
+    age = _age_seconds(path, now)
+    if age is None:
+        return {
+            "status": "degraded",
+            "reason": REASON_GPU_TELEMETRY_MISSING,
+            "detail": "No gpu_status.json is available for this run.",
+            "age_seconds": None,
+        }
+    try:
+        data = json.loads(path.read_text(encoding="utf-8", errors="replace"))
+    except (OSError, json.JSONDecodeError) as exc:
+        return {
+            "status": "degraded",
+            "reason": REASON_GPU_TELEMETRY_MISSING,
+            "detail": f"GPU status is unreadable: {exc}",
+            "age_seconds": age,
+        }
+    status = "healthy" if age <= max_age_seconds else "degraded"
+    reason = REASON_GPU_TELEMETRY_OK if status == "healthy" else REASON_GPU_TELEMETRY_MISSING
+    return {
+        "status": status,
+        "reason": reason,
+        "detail": "GPU telemetry is fresh." if status == "healthy" else "GPU telemetry is stale.",
+        "age_seconds": age,
+        "data": data,
+    }
+
+
+def _fmt_step(step: Any) -> str:
+    return f"{int(step):,}" if isinstance(step, int | float) else "unknown"
+
+
+def classify_trainer_health(
+    *,
+    docker: dict[str, Any],
+    progress: dict[str, Any],
+    gpu: dict[str, Any],
+    stale_warn_seconds: int = 300,
+    stale_offline_seconds: int = 900,
+) -> dict[str, Any]:
+    running = bool(docker.get("running"))
+    state = str(docker.get("state") or "unknown")
+    if not running:
+        return {
+            "overall": "offline",
+            "reason": REASON_TRAINER_PROCESS_DEAD,
+            "detail": f"The trainer container is {state}. Start or resume training to continue.",
+        }
+
+    health = docker.get("health")
+    latest_step = progress.get("latest_step")
+    if latest_step is None:
+        return {
+            "overall": "degraded",
+            "reason": REASON_TRAINER_STALE_STEP,
+            "detail": "The trainer container is running, but no training progress file or latest step was found.",
+        }
+
+    age = progress.get("step_stale_seconds")
+    if age is None:
+        age = progress.get("source_mtime_age_seconds")
+
+    if health == "unhealthy" or (isinstance(age, int | float) and age > stale_offline_seconds):
+        reason = (
+            REASON_INFRA_OK_BUT_TRAINER_STALE
+            if gpu.get("status") == "healthy"
+            else REASON_TRAINER_STALE_STEP
+        )
+        return {
+            "overall": "offline",
+            "reason": reason,
+            "detail": f"The trainer container is running, but step {_fmt_step(latest_step)} has not refreshed recently.",
+        }
+
+    if isinstance(age, int | float) and age > stale_warn_seconds:
+        return {
+            "overall": "degraded",
+            "reason": REASON_TRAINER_STALE_STEP,
+            "detail": f"The trainer is running, but step {_fmt_step(latest_step)} has not refreshed in {int(age)} seconds.",
+        }
+
+    return {
+        "overall": "healthy",
+        "reason": REASON_TRAINER_OK,
+        "detail": f"Training is running and reporting step {_fmt_step(latest_step)}.",
+    }
+
+
+def actions_for_status(status: dict[str, Any]) -> dict[str, bool]:
+    running = bool(status.get("running"))
+    return {
+        "can_start": not running,
+        "can_stop": running,
+        "can_restart": running,
+    }
+
+
+def build_training_status(
+    *,
+    container_name: str,
+    run_dir: Path,
+    runner: Runner,
+    now: datetime | None = None,
+) -> dict[str, Any]:
+    now = now or utcnow()
+    container = docker_container_probe(container_name=container_name, runner=runner)
+    progress = latest_training_step_from_run_dir(run_dir, now=now)
+    gpu = gpu_status_probe(run_dir, now=now)
+    classification = classify_trainer_health(docker=container, progress=progress, gpu=gpu)
+    logs = recent_logs_probe(container_name=container_name, runner=runner)
+
+    status = {
+        "schema_version": SCHEMA_VERSION,
+        "checked_at": isoformat_z(now),
+        "overall": classification["overall"],
+        "reason": classification["reason"],
+        "detail": classification["detail"],
+        "running": bool(container.get("running")),
+        "state": container.get("state", "unknown"),
+        "exit_code": container.get("exit_code"),
+        "started_at": container.get("started_at", ""),
+        "finished_at": container.get("finished_at", ""),
+        "container": container,
+        "trainer": progress,
+        "gpu": gpu,
+        "logs": logs,
+        "logs_tail": logs.get("stdout", ""),
+        "actions": actions_for_status(container),
+    }
+    return status
