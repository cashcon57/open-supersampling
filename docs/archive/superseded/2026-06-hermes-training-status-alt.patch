+// ── Training control panel (tailnet-gated) ──────────────────────────
+async function initTrainingControls() {
+  const API = localStorage.getItem('oss-training-api-url') || 'http://100.126.238.73:8765';
+  const SECRET_KEY = 'oss-training-api-secret';
+  const panel = document.getElementById('training-controls');
+  const badge = document.getElementById('train-status-badge');
+  const statusDetail = document.getElementById('train-status-detail');
+  const secretInput = document.getElementById('train-secret-input');
+  const secretSave = document.getElementById('train-secret-save');
+  const secretClear = document.getElementById('train-secret-clear');
+  const secretMsg = document.getElementById('train-secret-msg');
+  const startBtn = document.getElementById('train-btn-start');
+  const stopBtn = document.getElementById('train-btn-stop');
+  const restartBtn = document.getElementById('train-btn-restart');
+  const output = document.getElementById('train-api-output');
+
+  let secret = localStorage.getItem(SECRET_KEY) || '';
+  let busy = false;
+
+  // Check if we're on the tailnet
+  try {
+    const resp = await fetch(`${API}/health`, { mode: 'cors', signal: AbortSignal.timeout(3000) });
+    if (!resp.ok) return;
+    panel.classList.remove('hidden');
+  } catch (err) {
+    console.info('Trainer controls hidden: training API is not reachable from this browser.', err);
+    return; /* not on tailnet */
+  }
+
+  function authHeaders() { return { 'Authorization': `Bearer ${secret}` }; }
+
+  function trainBadgeClass(tone) {
+    const base = 'rounded border px-2 py-0.5 text-xs';
+    if (tone === 'good') return `${base} border-emerald-700 text-emerald-300`;
+    if (tone === 'warn') return `${base} border-amber-700 text-amber-300`;
+    if (tone === 'bad') return `${base} border-red-700 text-red-300`;
+    return `${base} border-zinc-700 text-zinc-300`;
+  }
+
+  function trainStateText(data) {
+    if (!data) return { badge: 'Unknown', detail: 'I could not read the trainer status yet.', tone: 'muted' };
+    if (data.reason === 'infra_ok_but_trainer_stale') {
+      return { badge: 'Trainer is stale', detail: data.detail || 'The infrastructure looks healthy, but the trainer has stopped reporting new progress.', tone: 'bad' };
+    }
+    if (data.reason === 'trainer_stale_step') {
+      return { badge: 'Trainer may be stuck', detail: data.detail || 'The trainer is running, but step or loss has not refreshed recently.', tone: 'warn' };
+    }
+    if (data.reason === 'gpu_telemetry_missing') {
+      return { badge: 'GPU telemetry missing', detail: data.detail || 'The trainer may be running, but GPU status is not available.', tone: 'warn' };
+    }
+    if (data.running) {
+      const step = data.trainer?.latest_step;
+      const stepText = Number.isFinite(step) ? ` Current step: ${step.toLocaleString()}.` : '';
+      return { badge: 'Training is running', detail: `${data.detail || 'The trainer container is running.'}${stepText}`, tone: data.overall === 'degraded' ? 'warn' : 'good' };
+    }
+    if (data.state === 'not-found') {
+      return { badge: 'Trainer is not created', detail: 'The trainer container does not exist yet. Use Start / resume to create and launch it.', tone: 'warn' };
+    }
+    if (data.state === 'exited') {
+      const exit = data.exit_code ?? 'unknown';
+      return { badge: 'Training is stopped', detail: `The trainer container exited with code ${exit}. Use Start / resume to continue from the configured checkpoint path.`, tone: exit === 0 ? 'muted' : 'bad' };
+    }
+    return { badge: `Trainer is ${data.state || 'not running'}`, detail: data.detail || 'The trainer is reachable, but Docker is reporting a non-running state.', tone: 'warn' };
+  }
+
+  function setActionButtons({ canStart, canStop, canRestart }) {
+    startBtn.disabled = !canStart || busy;
+    stopBtn.disabled = !canStop || busy;
+    restartBtn.disabled = !canRestart || busy;
+    startBtn.dataset.statusDisabled = String(!canStart);
+    stopBtn.dataset.statusDisabled = String(!canStop);
+    restartBtn.dataset.statusDisabled = String(!canRestart);
+  }
+
+  function setControlsBusy(isBusy, label = '') {
+    busy = isBusy;
+    for (const btn of [startBtn, stopBtn, restartBtn, secretSave, secretClear]) {
+      if (!btn) continue;
+      btn.disabled = isBusy || btn.dataset.statusDisabled === 'true';
+      btn.setAttribute('aria-busy', isBusy ? 'true' : 'false');
+    }
+    if (label) {
+      badge.textContent = label;
+      badge.className = trainBadgeClass('warn');
+      statusDetail.textContent = 'Waiting for the trainer API to finish the requested change…';
+    }
+  }
+
+  function showOutput(message, details = '') {
+    output.textContent = details ? `${message}\n\nDetails:\n${details}` : message;
+    output.classList.remove('hidden');
+  }
+
+  function actionPendingText(action) {
+    return { start: 'Starting trainer…', stop: 'Stopping trainer…', restart: 'Restarting trainer…' }[action] || 'Working…';
+  }
+
+  function actionResultText(action, data) {
+    const result = data?.result || 'unknown';
+    const failed = result === 'failed' || Number(data?.returncode || 0) !== 0;
+    if (action === 'start' && result === 'already-running') return { message: 'Training was already running.', tone: 'good' };
+    if (action === 'start' && result === 'started') return { message: 'Training started. I’ll refresh the status in a moment.', tone: 'good' };
+    if (action === 'stop' && result === 'stopped') return { message: 'Training stop was sent successfully. The container should report stopped shortly.', tone: 'warn' };
+    if (action === 'restart' && result === 'restarted') return { message: 'Trainer restart was sent successfully. Give it a few seconds to come back online.', tone: 'warn' };
+    if (result === 'busy') return { message: 'Another trainer command is already running. Wait for it to finish, then try again.', tone: 'warn' };
+    if (failed) return { message: `The ${action} command failed.`, tone: 'bad' };
+    return { message: `The ${action} command finished with result: ${result}.`, tone: 'muted' };
+  }
+
+  async function refreshStatus() {
+    if (!secret) {
+      badge.textContent = 'Locked';
+      badge.className = trainBadgeClass('muted');
+      statusDetail.textContent = 'Enter the trainer API secret to enable start, stop, and restart.';
+      setActionButtons({ canStart: false, canStop: false, canRestart: false });
+      return;
+    }
+    try {
+      const resp = await fetch(`${API}/status`, { headers: authHeaders(), signal: AbortSignal.timeout(5000) });
+      if (!resp.ok) {
+        badge.textContent = resp.status === 401 ? 'Secret rejected' : 'API error';
+        badge.className = trainBadgeClass('bad');
+        statusDetail.textContent = resp.status === 401 ? 'The API secret was rejected. Check the secret and unlock controls again.' : `The trainer API returned HTTP ${resp.status}.`;
+        setActionButtons({ canStart: false, canStop: false, canRestart: false });
+        return;
+      }
+      const data = await resp.json();
+      const state = trainStateText(data);
+      badge.textContent = state.badge;
+      badge.className = trainBadgeClass(state.tone);
+      statusDetail.textContent = state.detail;
+      const actions = data.actions || { can_start: !data.running, can_stop: data.running, can_restart: data.running };
+      setActionButtons({ canStart: !!actions.can_start, canStop: !!actions.can_stop, canRestart: !!actions.can_restart });
+    } catch (err) {
+      badge.textContent = 'API unreachable';
+      badge.className = trainBadgeClass('bad');
+      statusDetail.textContent = `Could not contact the trainer API: ${err.message}`;
+      setActionButtons({ canStart: false, canStop: false, canRestart: false });
+    }
+  }
+
+  async function apiAction(action) {
+    if (!secret) {
+      showOutput('Enter the trainer API secret before using the controls.');
+      secretInput.focus();
+      return;
+    }
+    setControlsBusy(true, actionPendingText(action));
+    try {
+      const resp = await fetch(`${API}/${action}`, { method: 'POST', headers: authHeaders(), signal: AbortSignal.timeout(120000) });
+      let data = {};
+      try { data = await resp.json(); } catch { data = { result: 'failed', stderr: 'The training API returned a non-JSON response.' }; }
+      if (!resp.ok) {
+        const msg = resp.status === 401 ? 'The API secret was rejected. Check the secret and try again.' : `The training API returned HTTP ${resp.status}.`;
+        showOutput(msg, data.error || data.message || data.stderr || '');
+        badge.textContent = resp.status === 401 ? 'Secret rejected' : 'API error';
+        badge.className = trainBadgeClass('bad');
+        return;
+      }
+      const result = actionResultText(action, data);
+      showOutput(result.message, [data.stdout, data.stderr ? `STDERR:\n${data.stderr}` : ''].filter(Boolean).join('\n'));
+      badge.textContent = result.message;
+      badge.className = trainBadgeClass(result.tone);
+    } catch (err) {
+      const timedOut = /aborted|timeout/i.test(err?.message || '');
+      showOutput(timedOut ? 'The trainer API did not answer before the timeout.' : `Could not contact the trainer API: ${err.message}`);
+      badge.textContent = timedOut ? 'Request timed out' : 'API unreachable';
+      badge.className = trainBadgeClass('bad');
+    } finally {
+      setControlsBusy(false);
+      setTimeout(refreshStatus, 2000);
+    }
+  }
+
+  secretSave.addEventListener('click', () => {
+    const val = secretInput.value.trim();
+    if (!val) {
+      secretMsg.textContent = 'Enter the trainer API secret first.';
+      secretMsg.className = 'text-xs text-amber-300';
+      return;
+    }
+    secret = val;
+    localStorage.setItem(SECRET_KEY, secret);
+    secretMsg.textContent = 'Controls unlocked in this browser.';
+    secretMsg.className = 'text-xs text-emerald-400';
+    refreshStatus();
+  });
+
+  secretClear.addEventListener('click', () => {
+    secret = '';
+    localStorage.removeItem(SECRET_KEY);
+    secretInput.value = '';
+    secretMsg.textContent = 'Secret removed from this browser.';
+    secretMsg.className = 'text-xs text-zinc-400';
+    badge.textContent = 'Locked';
+    badge.className = trainBadgeClass('muted');
+    statusDetail.textContent = 'Enter the trainer API secret to enable start, stop, and restart.';
+    setActionButtons({ canStart: false, canStop: false, canRestart: false });
+    output.classList.add('hidden');
+  });
+
+  secretInput.addEventListener('keydown', (event) => {
+    if (event.key === 'Enter') secretSave.click();
+  });
+
+  // Pre-fill from localStorage
+  if (secret) {
+    secretInput.value = secret;
+    secretMsg.textContent = 'Saved secret loaded from this browser.';
+    secretMsg.className = 'text-xs text-zinc-400';
+    refreshStatus();
+  } else {
+    refreshStatus();
+  }
+
+  startBtn.addEventListener('click', () => apiAction('start'));
+  stopBtn.addEventListener('click', () => apiAction('stop'));
+  restartBtn.addEventListener('click', () => apiAction('restart'));
+}
+
