+import json
+import subprocess
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+from scripts import training_status
+
+
+def test_parse_docker_inspect_extracts_running_health():
+    payload = [{
+        "State": {
+            "Running": True,
+            "Status": "running",
+            "ExitCode": 0,
+            "StartedAt": "2026-06-08T01:00:00Z",
+            "FinishedAt": "0001-01-01T00:00:00Z",
+            "Health": {"Status": "healthy", "FailingStreak": 0, "Log": [{"Output": "ok"}]},
+            "OOMKilled": False,
+            "Dead": False,
+            "Restarting": False,
+            "Error": "",
+        }
+    }]
+
+    parsed = training_status.parse_docker_inspect(json.dumps(payload))
+
+    assert parsed["running"] is True
+    assert parsed["state"] == "running"
+    assert parsed["health"] == "healthy"
+    assert parsed["health_failing_streak"] == 0
+
+
+def test_parse_docker_inspect_missing_or_invalid_returns_unknown():
+    parsed = training_status.parse_docker_inspect("not json")
+
+    assert parsed["running"] is False
+    assert parsed["state"] == "unknown"
+    assert parsed["reason"] == "docker_inspect_parse_failed"
+
+
+def test_latest_training_step_from_history_jsonl_ignores_torn_final_line(tmp_path: Path):
+    run_dir = tmp_path / "run"
+    run_dir.mkdir()
+    history = run_dir / "history.jsonl"
+    history.write_text('{"step": 10, "loss": 0.2}\n{"step": 12, "loss": 0.1}\n{"step": ', encoding="utf-8")
+
+    latest = training_status.latest_training_step_from_run_dir(run_dir)
+
+    assert latest["latest_step"] == 12
+    assert latest["source"] == "history.jsonl"
+    assert latest["status"] == "healthy"
+
+
+def test_gpu_status_missing_is_gpu_telemetry_missing(tmp_path: Path):
+    result = training_status.gpu_status_probe(tmp_path, now=datetime.now(timezone.utc))
+
+    assert result["status"] == "degraded"
+    assert result["reason"] == "gpu_telemetry_missing"
+
+
+def test_classify_running_stale_step_as_infra_ok_but_trainer_stale():
+    result = training_status.classify_trainer_health(
+        docker={"running": True, "state": "running", "health": "healthy"},
+        progress={"latest_step": 17700, "step_stale_seconds": 3600, "status": "degraded"},
+        gpu={"status": "healthy", "reason": "gpu_telemetry_ok"},
+        stale_offline_seconds=900,
+    )
+
+    assert result["overall"] == "offline"
+    assert result["reason"] == "infra_ok_but_trainer_stale"
+    assert "17,700" in result["detail"]
+
+
+def test_classify_running_without_progress_is_not_healthy():
+    result = training_status.classify_trainer_health(
+        docker={"running": True, "state": "running", "health": "healthy"},
+        progress={"latest_step": None, "status": "unknown", "reason": "training_progress_missing"},
+        gpu={"status": "degraded", "reason": "gpu_telemetry_missing"},
+    )
+
+    assert result["overall"] == "degraded"
+    assert result["reason"] == "trainer_stale_step"
+    assert "running" in result["detail"]
+    assert "no training progress" in result["detail"]
+
+
+def test_classify_exited_container_as_process_dead():
+    result = training_status.classify_trainer_health(
+        docker={"running": False, "state": "exited", "exit_code": 137},
+        progress={"latest_step": None, "status": "unknown"},
+        gpu={"status": "unknown", "reason": "gpu_telemetry_missing"},
+    )
+
+    assert result["overall"] == "offline"
+    assert result["reason"] == "trainer_process_dead"
+    assert "exited" in result["detail"]
+
+
+def test_build_training_status_includes_legacy_fields_and_actions(tmp_path: Path):
+    run_dir = tmp_path / "run"
+    run_dir.mkdir()
+    (run_dir / "history.jsonl").write_text('{"step": 42, "loss": 0.1}\n', encoding="utf-8")
+    (run_dir / "gpu_status.json").write_text('{"name": "RTX 3080 Ti", "utilization_gpu": 91}\n', encoding="utf-8")
+
+    def fake_runner(args, timeout=120):
+        if args[:2] == ["docker", "inspect"]:
+            return subprocess.CompletedProcess(args, 0, json.dumps([{"State": {"Running": True, "Status": "running", "ExitCode": 0, "Health": {"Status": "healthy", "FailingStreak": 0}}}]), "")
+        if args[:2] == ["docker", "logs"]:
+            return subprocess.CompletedProcess(args, 0, "step 42 ok", "")
+        raise AssertionError(args)
+
+    status = training_status.build_training_status(
+        container_name="oss-trainer",
+        run_dir=run_dir,
+        runner=fake_runner,
+        now=datetime.now(timezone.utc),
+    )
+
+    assert status["schema_version"] == "2026-06-training-control-v1"
+    assert status["running"] is True
+    assert status["state"] == "running"
+    assert status["container"]["health"] == "healthy"
+    assert status["trainer"]["latest_step"] == 42
+    assert status["actions"] == {"can_start": False, "can_stop": True, "can_restart": True}
+    assert "logs_tail" in status
